@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="auth">
    <div class="auth__card">
        @if (Model.Done)
        {
            <div class="auth__head">
                <h1 class="auth__title">Password changed</h1>
                <p class="auth__sub">You can log in with your new password now.</p>
            </div>
            <div class="form-actions is-center">
                <a class="btn btn-primary btn-lg" asp-page="./Login">Log in</a>
            </div>
        }
        else if (Model.BadLink)
        {
            <div class="auth__head">
                <h1 class="auth__title">That link doesn't work</h1>
                <p class="auth__sub">Reset links work once, for one day. Ask for a fresh one and use the newest email.</p>
            </div>
            <div class="form-actions is-center">
                <a class="btn btn-primary btn-lg" asp-page="./ForgotPassword">Send a new link</a>
            </div>
        }
        else
        {
            <div class="auth__head">
                <h1 class="auth__title">Choose a new password</h1>
                <p class="auth__sub">For the account with <strong>@Model.Email</strong>.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Code" />
                @* Lets password managers pair the new password with the right account. *@
                <input type="text" class="visually-hidden" autocomplete="username" value="@Model.Email" tabindex="-1" aria-hidden="true" readonly />
                <div class="field">
                    <label asp-for="Password" class="field__label">New password</label>
                    <div class="password">
                        <input asp-for="Password" class="input" autocomplete="new-password" required minlength="8" maxlength="100" placeholder="At least 8 characters" />
                        <button type="button" class="password__toggle" data-reveal aria-pressed="false">Show</button>
                    </div>
                    <span asp-validation-for="Password" class="field__error"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg btn-block">Save password</button>
            </form>
        }
    </div>
</div>
