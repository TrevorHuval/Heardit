@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}

<div class="auth">
    <div class="auth__card">
        @if (Model.Submitted)
        {
            <div class="auth__head">
                <h1 class="auth__title">Check your inbox</h1>
                <p class="auth__sub">
                    If <strong>@Model.Email</strong> belongs to an account with a confirmed email, a reset link is on its way.
                    It works for one day.
                </p>
            </div>
            <p class="auth__note">
                Nothing arriving? Check spam, or try the address you signed up with. Accounts that never confirmed
                their email can't be reset by email.
            </p>
            <div class="form-actions is-center">
                <a class="btn btn-ghost btn-lg" asp-page="./Login">Back to log in</a>
            </div>
        }
        else
        {
            <div class="auth__head">
                <h1 class="auth__title">Reset your password</h1>
                <p class="auth__sub">Enter your account's email and we'll send you a link to choose a new password.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
                <div class="field">
                    <label asp-for="Email" class="field__label">Email</label>
                    <input asp-for="Email" class="input" autocomplete="email" required placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="field__error"></span>
                </div>
                <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
            </form>

            <div class="auth__foot">
                <span>Remembered it? <a asp-page="./Login">Log in</a></span>
            </div>
        }
    </div>
</div>
