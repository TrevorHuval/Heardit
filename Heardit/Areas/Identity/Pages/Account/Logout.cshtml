@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth">
    <div class="auth__card">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="auth__head">
                <h1 class="auth__title">Log out</h1>
                <p class="auth__sub">Ready to sign off? You can jump back in any time.</p>
            </div>
            <form class="form-actions is-center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-primary btn-lg">Log out</button>
            </form>
        }
        else
        {
            <div class="auth__head">
                <h1 class="auth__title">Logged out</h1>
                <p class="auth__sub">You have successfully logged out.</p>
            </div>
            <div class="form-actions is-center">
                <a class="btn btn-ghost btn-lg" asp-area="" asp-controller="Home" asp-action="Index">Back to Heardit</a>
            </div>
        }
    </div>
</div>
