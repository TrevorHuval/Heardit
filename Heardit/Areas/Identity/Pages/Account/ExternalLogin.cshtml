@page
@model ExternalLoginModel
@using Heardit.Services
@{
    ViewData["Title"] = "Choose a username";
}

<div class="auth">
    <div class="auth__card">
        <div class="auth__head">
            <h1 class="auth__title">One last thing</h1>
            <p class="auth__sub">
                You're signing up with @Model.ProviderDisplayName@(Model.ProviderEmail != null ? " as " : "")<strong>@Model.ProviderEmail</strong>.
                Pick the username people will see.
            </p>
        </div>

        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

            <div class="field">
                <label asp-for="Input.UserName" class="field__label"></label>
                <input asp-for="Input.UserName" class="input" autocomplete="username" autocapitalize="none" spellcheck="false"
                       required minlength="@UserNameRules.MinLength" maxlength="@UserNameRules.MaxLength" pattern="[A-Za-z0-9._\-]+" aria-describedby="usernameHint" />
                <span class="field__hint" id="usernameHint">@UserNameRules.Hint It's your profile address.</span>
                <span asp-validation-for="Input.UserName" class="field__error"></span>
            </div>

            @if (Model.ProviderEmail == null)
            {
                <div class="field">
                    <label asp-for="Input.Email" class="field__label"></label>
                    <input asp-for="Input.Email" class="input" autocomplete="email" required placeholder="you@example.com" />
                    <span class="field__hint">We'll send a link to confirm it.</span>
                    <span asp-validation-for="Input.Email" class="field__error"></span>
                </div>
            }

            <button type="submit" class="btn btn-primary btn-lg btn-block">Create account</button>
        </form>

        <div class="auth__foot">
            <span>Not what you meant? <a asp-page="./Login">Back to log in</a></span>
        </div>
    </div>
</div>
