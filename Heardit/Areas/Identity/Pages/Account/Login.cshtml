@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth">
    <div class="auth__card">
        <div class="auth__head">
            <h1 class="auth__title">Welcome back</h1>
            <p class="auth__sub">Log in to rate tracks and follow other listeners.</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="field">
                <label asp-for="Input.UserName" class="field__label"></label>
                <input asp-for="Input.UserName" class="input" autocomplete="username" aria-required="true" placeholder="Your username" />
                <span asp-validation-for="Input.UserName" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password" class="field__label"></label>
                <input asp-for="Input.Password" class="input" autocomplete="current-password" aria-required="true" placeholder="Your password" />
                <span asp-validation-for="Input.Password" class="field__error"></span>
            </div>

            <div class="field">
                <label class="check">
                    <input class="check__box" asp-for="Input.RememberMe" />
                    <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                </label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary btn-lg btn-block">Log in</button>
        </form>

        @* No password reset: the app sends no email, so the flow would go nowhere (see /Home/Privacy). *@
        <div class="auth__foot">
            <span>New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
