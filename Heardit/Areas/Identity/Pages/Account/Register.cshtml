@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth">
    <div class="auth__card">
        <div class="auth__head">
            <h1 class="auth__title">Create your account</h1>
            <p class="auth__sub">Join Heardit to rate tracks and build your review feed.</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="field">
                <label asp-for="Input.UserName" class="field__label"></label>
                <input asp-for="Input.UserName" class="input" autocomplete="username" aria-required="true" placeholder="Pick a username" />
                <span asp-validation-for="Input.UserName" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Email" class="field__label"></label>
                <input asp-for="Input.Email" class="input" autocomplete="email" aria-required="true" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password" class="field__label"></label>
                <input asp-for="Input.Password" class="input" autocomplete="new-password" aria-required="true" placeholder="Create a password" />
                <span asp-validation-for="Input.Password" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword" class="field__label"></label>
                <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" aria-required="true" placeholder="Re-enter your password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field__error"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg btn-block">Create account</button>
        </form>

        <div class="auth__foot">
            <span>Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
