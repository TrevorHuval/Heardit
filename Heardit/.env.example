# Copy to `.env` (gitignored) and fill in real values before `docker compose up`.

# --- PostgreSQL ---
# Compose provisions the `db` service with these and the app connects using them.
POSTGRES_USER=heardit
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Spotify API (https://developer.spotify.com/dashboard) ---
# Names match the app's configuration keys (Spotify:ClientId / Spotify:ClientSecret).
Spotify__ClientId=your-spotify-client-id
Spotify__ClientSecret=your-spotify-client-secret

# --- Account email (optional; Amazon SES SMTP credentials, see docs/DEPLOY.md) ---
Email__Host=
Email__Username=
Email__Password=
Email__From=

# --- Sign in with Google (optional; see docs/DEPLOY.md) ---
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
