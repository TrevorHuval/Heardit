@{
    ViewData["Title"] = "Heardit";
}

@model IEnumerable<SpotifyAPI.Web.SimpleTrack>

<div class="feed__head">
    <h1 class="feed__title">New Releases</h1>
    <p class="feed__sub">Fresh drops from Spotify — play a track, then rate it and read the reviews.</p>
</div>

@if (Model.Any())
{
    <div class="feed">
        @foreach (var item in Model)
        {
            var artists = item.Artists != null ? string.Join(", ", item.Artists.Select(a => a.Name)) : string.Empty;
            <article class="track">
                <div class="track__player">
                    <iframe src="https://open.spotify.com/embed/track/@item.Id?utm_source=generator&theme=0" height="152" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="@item.Name by @artists"></iframe>
                </div>
                <a class="track__reviews" asp-area="" asp-controller="Songs" asp-action="Index" asp-route-songId="@item.Id" aria-label="See reviews for @item.Name">
                    <span>See reviews</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>
            </article>
        }
    </div>
}
else
{
    <div class="empty">No new releases to show right now. Check back soon.</div>
}
