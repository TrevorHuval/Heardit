@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="home">
    <section class="home-section" aria-labelledby="friends-title">
        <partial name="_SectionHead" model="@(new SectionHeadViewModel("friends-title", "From people you follow", SeeAllAction: Model.MoreFriendReviews ? "Following" : null))" />
        @if (!Model.FollowsAnyone)
        {
            <div class="prompt-card">
                <p class="prompt-card__text">
                    Follow other listeners and their reviews show up here first.
                    Find someone in the latest reviews below, or search for them by name.
                </p>
                <a class="btn btn-ghost btn-sm" asp-controller="Home" asp-action="Latest">Browse reviews</a>
            </div>
        }
        else if (Model.FriendReviews.Count > 0)
        {
            <div class="reviews">
                @foreach (Review review in Model.FriendReviews)
                {
                    <partial name="_ReviewPartial" model="@ReviewViewModel.For(review, Model.LikeStats)" />
                }
            </div>
        }
        else
        {
            <div class="empty">Nothing from people you follow yet.</div>
        }
    </section>

    @if (Model.Trending.Count > 0)
    {
        <section class="home-section" aria-labelledby="trending-title">
            <partial name="_SectionHead" model="@(new SectionHeadViewModel(
                "trending-title",
                Model.TrendingIsAllTime ? "Most reviewed" : "Trending this week",
                Model.TrendingIsAllTime ? "What Heardit listeners have talked about most." : "Most reviews and likes on Heardit in the last seven days.",
                "Trending"))" />
            <div class="shelf" role="list">
                @foreach (var tile in Model.Trending)
                {
                    <div class="shelf__item" role="listitem"><partial name="_ShelfTile" model="tile" /></div>
                }
            </div>
        </section>
    }

    <section class="home-section" aria-labelledby="releases-title">
        <partial name="_SectionHead" model="@(new SectionHeadViewModel("releases-title", "New Releases", "The biggest drops on Spotify from the last two weeks.", Model.NewReleases.Count > 0 ? "NewReleases" : null))" />
        @if (Model.SpotifyUnavailable)
        {
            <div class="empty">Couldn't reach Spotify just now. Try again in a minute.</div>
        }
        else if (Model.NewReleases.Count > 0)
        {
            <div class="shelf" role="list">
                @foreach (var tile in Model.NewReleases)
                {
                    <div class="shelf__item" role="listitem"><partial name="_ShelfTile" model="tile" /></div>
                }
            </div>
        }
        else
        {
            <div class="empty">No new releases to show right now. Check back soon.</div>
        }
    </section>

    <section class="home-section" aria-labelledby="latest-title">
        <partial name="_SectionHead" model="@(new SectionHeadViewModel("latest-title", "Latest from everyone", SeeAllAction: Model.LatestReviews.Count > 0 ? "Latest" : null))" />
        @if (Model.LatestReviews.Count > 0)
        {
            <div class="reviews">
                @foreach (Review review in Model.LatestReviews)
                {
                    <partial name="_ReviewPartial" model="@ReviewViewModel.For(review, Model.LikeStats)" />
                }
            </div>
        }
        else
        {
            <div class="empty">Nobody has reviewed anything yet. Search for a track and be the first.</div>
        }
    </section>
</div>
