@model FollowViewModel
@using Heardit.Areas.Identity.Data;
@{
    ViewData["Title"] = "Follow";
    var IsCurrentUser = Model.User.Id.Equals(User.GetLoggedInUserId<string>());
    var followsListRoute = new Dictionary<string, string>()
    {
        { "username", Model.User.UserName ?? string.Empty }
    };
}

@functions {
    static string Initials(string? name)
    {
        var n = (name ?? "").Trim();
        if (n.Length == 0) return "?";
        var parts = n.Split(new[] { ' ', '_', '-', '.' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        return n.Length >= 2 ? n.Substring(0, 2).ToUpper() : n.ToUpper();
    }
}

<div class="follows">
    <header class="profile__banner">
        <div class="avatar avatar--xl avatar--brand" aria-hidden="true">@Initials(Model.User.UserName)</div>
        <div class="profile__id">
            <p class="eyebrow">Listener</p>
            <h1 class="profile__name">@Model.User.UserName</h1>
        </div>
        <div class="profile__stats">
            <a class="stat" asp-action="Index" asp-controller="Follow" asp-all-route-data="followsListRoute">
                <span class="stat__num tnum">@Model.FollowersCount</span>
                <span class="stat__label">Followers</span>
            </a>
            <a class="stat" asp-action="Index" asp-controller="Follow" asp-all-route-data="followsListRoute">
                <span class="stat__num tnum">@Model.FollowingCount</span>
                <span class="stat__label">Following</span>
            </a>
        </div>
        <div class="profile__action">
            @if (IsCurrentUser)
            {
                <a id="manage" class="btn btn-ghost" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Edit profile</a>
            }
            else
            {
                var followRoute = new Dictionary<string, string>() { { "userId", Model.User.Id } };
                if (Model.IsFollowing)
                {
                    <form asp-action="UnFollow" asp-controller="Profile" asp-all-route-data="followRoute" method="post">
                        <button type="submit" class="btn btn-ghost">Unfollow</button>
                    </form>
                }
                else
                {
                    <form asp-action="Follow" asp-controller="Profile" asp-all-route-data="followRoute" method="post">
                        <button type="submit" class="btn btn-primary">Follow</button>
                    </form>
                }
            }
        </div>
    </header>

    <section class="profile__section">
        <div class="tabs nav" role="tablist">
            <button class="tab active" data-bs-toggle="tab" data-bs-target="#Followers" id="Followers-tab" type="button" role="tab" aria-controls="Followers" aria-selected="true">Followers</button>
            <button class="tab" data-bs-toggle="tab" data-bs-target="#Following" id="Following-tab" type="button" role="tab" aria-controls="Following" aria-selected="false">Following</button>
        </div>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="Followers" role="tabpanel" aria-labelledby="Followers-tab">
                @if (Model.FollowersList.Count != 0)
                {
                    <div class="user-list">
                        @foreach (HearditUser user in Model.FollowersList)
                        {
                            <a class="user-row" asp-controller="Profile" asp-action="Index" asp-route-username="@user.UserName">
                                <span class="avatar avatar--sm avatar--brand" aria-hidden="true">@Initials(user.UserName)</span>
                                <span class="user-row__name">@user.UserName</span>
                                <svg class="user-row__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty">This listener isn't followed by anyone yet.</div>
                }
            </div>
            <div class="tab-pane fade" id="Following" role="tabpanel" aria-labelledby="Following-tab">
                @if (Model.FollowingList.Count != 0)
                {
                    <div class="user-list">
                        @foreach (HearditUser user in Model.FollowingList)
                        {
                            <a class="user-row" asp-controller="Profile" asp-action="Index" asp-route-username="@user.UserName">
                                <span class="avatar avatar--sm avatar--brand" aria-hidden="true">@Initials(user.UserName)</span>
                                <span class="user-row__name">@user.UserName</span>
                                <svg class="user-row__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty">This listener isn't following anyone yet.</div>
                }
            </div>
        </div>
    </section>
</div>
