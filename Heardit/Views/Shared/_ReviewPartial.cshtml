@model ReviewViewModel

@using Heardit.Areas.Identity.Data
@{
    var IsUsersPost = Model.Review.UserId.Equals(User.GetLoggedInUserId<string>());
    var createdUtc = DateTime.SpecifyKind(Model.Review.CreatedAt, DateTimeKind.Utc);
    var createdUnix = new DateTimeOffset(createdUtc).ToUnixTimeSeconds();
    // Liking is a form POST, so the page reloads; come back to this list, this page, this review.
    var anchor = $"review-{Model.Review.ReviewId}";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}#{anchor}";
}

@functions {
    static string TimeAgo(DateTime createdUtc)
    {
        var span = DateTime.UtcNow - createdUtc;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        if (span.TotalDays < 30) return $"{(int)(span.TotalDays / 7)}w ago";
        if (span.TotalDays < 365) return $"{(int)(span.TotalDays / 30)}mo ago";
        return $"{(int)(span.TotalDays / 365)}y ago";
    }
}

<article class="review" id="@anchor" data-rating="@Model.Review.Rating" data-created="@createdUnix">
    <div class="review__head">
        <div class="score score--chip" title="Rated @Model.Review.Rating out of 10">
            <span class="score__value">@Model.Review.Rating</span><span class="score__scale">/10</span>
        </div>
        <div class="review__meta">
            <a class="review__song" asp-controller="Songs" asp-action="Index" asp-route-songId="@Model.Review.SongId">@Model.Review.SongName</a>
            <span class="review__by">
                by <a asp-controller="Profile" asp-action="Index" asp-route-username="@Model.Review.User.UserName">@Model.Review.User.UserName</a>
                <span class="review__time">· @TimeAgo(createdUtc)</span>
                @if (Model.Review.UpdatedAt != null)
                {
                    <span class="review__edited">· edited</span>
                }
            </span>
        </div>
        @if (IsUsersPost)
        {
            <div class="review__actions">
                <form asp-action="Delete" asp-controller="Review" asp-route-reviewid="@Model.Review.ReviewId" method="post">
                    <button type="submit" class="btn btn-ghost-danger btn-sm" aria-label="Delete this review">Delete</button>
                </form>
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Review.WrittenReview))
    {
        <p class="review__body">@Model.Review.WrittenReview</p>
    }
    <div class="review__foot">
        <form asp-action="ToggleLike" asp-controller="Review" method="post">
            <input type="hidden" name="reviewId" value="@Model.Review.ReviewId" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="like @(Model.LikedByMe ? "is-liked" : "")" aria-pressed="@(Model.LikedByMe ? "true" : "false")"
                    title="@(Model.LikedByMe ? "Unlike this review" : "Like this review")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="@(Model.LikedByMe ? "currentColor" : "none")" aria-hidden="true" focusable="false">
                    <path d="M12 20.5 4.2 13a4.8 4.8 0 0 1 6.8-6.8l1 1 1-1A4.8 4.8 0 0 1 19.8 13z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                </svg>
                <span class="like__count tnum">@Model.LikeCount</span>
                <span class="visually-hidden">@(Model.LikeCount == 1 ? "like" : "likes")</span>
            </button>
        </form>
    </div>
</article>
