@model SectionHeadViewModel

<div class="section-head">
    <div class="section-head__text">
        <h2 class="section-title" id="@Model.Id">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="section-head__sub">@Model.Subtitle</p>
        }
    </div>
    @if (Model.SeeAllAction != null)
    {
        <a class="section-head__all" asp-controller="Home" asp-action="@Model.SeeAllAction" aria-label="See all: @Model.Title">
            See all
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>
    }
</div>
