@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="state">
    <span class="state__badge" aria-hidden="true">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
            <path d="M12 8v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="12" cy="16.5" r="1.25" fill="currentColor" />
            <path d="M12 3.5 21 19H3L12 3.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        </svg>
    </span>
    <h1 class="state__title">Something went wrong</h1>
    <p class="state__text">We hit an unexpected snag while loading this page. Try again, or head back to new releases.</p>

    @if (Model.ShowRequestId)
    {
        <p class="state__req">Request ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to Heardit</a>
</div>
