@model FeedItemViewModel
@{
    // Saving is a form POST, so the page reloads; come back to this feed, this page, this card.
    var anchor = $"track-{Model.Id}";
    var returnUrl = $"{Context.Request.GetEncodedPathAndQuery()}#{anchor}";
    var credit = string.IsNullOrWhiteSpace(Model.Artists) ? Model.Name : $"{Model.Name} by {Model.Artists}";
}

<article class="track" id="@anchor">
    @* The Spotify player is a few megabytes of script per card, so a feed of twenty never loads one
       up front. The cover stands in; clicking it swaps the real embed in (site.js) and the player
       takes it from there. Without JavaScript the cover is a plain link to the song page. *@
    <div class="track__player" data-embed-track="@Model.Id" data-embed-title="@credit">
        <a class="cover" asp-area="" asp-controller="Songs" asp-action="Index" asp-route-songId="@Model.Id" data-play aria-label="Play @credit">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img class="cover__art" src="@Model.ImageUrl" alt="" loading="lazy" decoding="async" width="300" height="300" />
            }
            else
            {
                <span class="cover__art cover__art--blank" aria-hidden="true"></span>
            }
            <span class="cover__meta">
                <span class="cover__name">@Model.Name</span>
                @if (!string.IsNullOrWhiteSpace(Model.Artists))
                {
                    <span class="cover__artists">@Model.Artists</span>
                }
            </span>
            <span class="cover__play" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    <path d="M8 5.5v13a1 1 0 0 0 1.5.87l11-6.5a1 1 0 0 0 0-1.74l-11-6.5A1 1 0 0 0 8 5.5z" />
                </svg>
            </span>
        </a>
    </div>
    <div class="track__foot">
        <form asp-action="Toggle" asp-controller="ListenLater" method="post">
            <input type="hidden" name="songId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="save @(Model.Saved ? "is-saved" : "")" aria-pressed="@(Model.Saved ? "true" : "false")"
                    title="@(Model.Saved ? $"Remove {Model.Name} from your queue" : $"Save {Model.Name} for later")">
                <partial name="_SaveIcon" model="Model.Saved" />
                <span>@(Model.Saved ? "Saved" : "Save")</span>
            </button>
        </form>
        <a class="track__reviews" asp-area="" asp-controller="Songs" asp-action="Index" asp-route-songId="@Model.Id" aria-label="See reviews for @Model.Name">
            @if (Model.ReviewCount > 0)
            {
                <span class="track__stat">
                    <span class="score score--mini" title="Average @Model.AverageRating out of 10"><span class="score__value">@Model.AverageRating</span><span class="score__scale">/10</span></span>
                    <span class="count">@Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")</span>
                </span>
            }
            else
            {
                <span class="track__prompt">Be the first to review</span>
            }
            <span class="track__cta">
                Reviews
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </a>
    </div>
</article>
