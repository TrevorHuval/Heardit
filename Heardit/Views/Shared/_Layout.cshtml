<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>@ViewData["Title"] - Heardit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="topbar__inner">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Heardit home">
                <svg class="brand__mark" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <rect x="2" y="9" width="3" height="6" rx="1.5" fill="currentColor" />
                    <rect x="7" y="5" width="3" height="14" rx="1.5" fill="currentColor" />
                    <rect x="12" y="2" width="3" height="20" rx="1.5" fill="currentColor" />
                    <rect x="17" y="7" width="3" height="10" rx="1.5" fill="currentColor" />
                </svg>
                <span class="brand__word">Heardit</span>
            </a>

            <form class="search" asp-controller="Search" asp-action="_Search" method="get" role="search">
                <button id="submitSearch" type="submit" class="search__btn" aria-label="Search">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" />
                    </svg>
                </button>
                <input id="searchInput" type="text" class="search__input" name="SearchString" placeholder="Search tracks…" aria-label="Search tracks" autocomplete="off" required />
            </form>

            <partial name="_LoginPartial" />
        </nav>
    </header>

    <main role="main" class="page-main">
        @if (TempData["Flash"] is string flashMessage)
        {
            <div class="flash" data-flash role="status">
                <span class="flash__icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span class="flash__text">@flashMessage</span>
                <button type="button" class="flash__close" data-flash-close aria-label="Dismiss">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://open.spotify.com/embed-podcast/iframe-api/v1" async></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
