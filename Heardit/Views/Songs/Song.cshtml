@model SongViewModel
@using Heardit.Areas.Identity.Data;
@using Heardit.Models;
@{
    ViewData["Title"] = "Song";
    var UserAlreadyReviewed = false;
    decimal avgRating = decimal.Zero;
    var reviewCount = Model.Reviews.Count;
    if (reviewCount > 0)
    {
        var ratingList = Model.Reviews.Select(r => r.Rating).ToList();
        avgRating = Math.Round(ratingList.Average(), 2);
        UserAlreadyReviewed = Model.Reviews.Where(r => r.User.Id.Equals(User.GetLoggedInUserId<string>())).FirstOrDefault() != null;
    }
}

<div class="song">
    <div class="song__player">
        <iframe src="https://open.spotify.com/embed/track/@Model.Song.Id?utm_source=generator&theme=0" width="100%" height="352" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="Spotify player"></iframe>
    </div>

    <div class="song__body">
        @if (reviewCount > 0)
        {
            <div class="rating-summary">
                <div class="score score--hero" title="Average rating @avgRating out of 10">
                    <span class="score__value">@avgRating</span><span class="score__scale">/10</span>
                </div>
                <div class="rating-summary__meta">
                    <span class="rating-summary__label">Average rating</span>
                    <span class="rating-summary__count">from @reviewCount @(reviewCount == 1 ? "review" : "reviews")</span>
                </div>
            </div>
        }

        @if (!UserAlreadyReviewed)
        {
            <form class="composer" asp-action="SubmitReview" asp-controller="Songs" asp-route-songId="@Model.Song.Id" method="post">
                <h2 class="composer__title">Rate this track</h2>
                <div class="fader">
                    <div class="fader__head">
                        <label for="rating" class="fader__label">Your rating</label>
                        <output for="rating" id="ratingValue" class="score score--input">1.0</output>
                    </div>
                    <input type="range" class="range" id="rating" name="rating" min="1" max="10" step="0.1" value="1" />
                    <div class="fader__scale"><span>1</span><span>10</span></div>
                </div>
                <textarea class="input" id="writtenReview" name="writtenReview" rows="3" placeholder="Share your thoughts on this track… (optional)"></textarea>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Post review</button>
                </div>
            </form>
        }

        <section class="song__reviews">
            <h2 class="section-title">Reviews</h2>
            @if (reviewCount > 0)
            {
                <div class="reviews">
                    @foreach (Review review in Model.Reviews)
                    {
                        var reviewModel = new ReviewViewModel() { Review = review };
                        <partial name="_ReviewPartial" model="reviewModel" />
                    }
                </div>
            }
            else
            {
                <div class="empty">No reviews yet — be the first to rate this track.</div>
            }
        </section>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        (function () {
            var slider = document.getElementById('rating');
            var out = document.getElementById('ratingValue');
            if (!slider) return;
            function update() {
                var v = parseFloat(slider.value);
                var min = parseFloat(slider.min);
                var max = parseFloat(slider.max);
                var pct = ((v - min) / (max - min)) * 100;
                slider.style.setProperty('--_p', pct + '%');
                if (out) { out.textContent = v.toFixed(1); }
            }
            slider.addEventListener('input', update);
            update();
        })();
    </script>
}
