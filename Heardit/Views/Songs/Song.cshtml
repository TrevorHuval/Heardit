@model SongViewModel
@using Heardit.Models;
@{
    ViewData["Title"] = "Song";
    var myReview = Model.MyReview;
    var others = Model.Reviews;
    var reviewCount = Model.ReviewCount;
    var avgRating = Model.AverageRating;
    var editing = myReview != null; // composer starts collapsed when a review already exists
    // Both toggles post and come back here, so they carry the page they were pressed on.
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="song">
    <div class="song__player">
        <iframe src="https://open.spotify.com/embed/track/@Model.Song.Id?utm_source=generator&theme=0" width="100%" height="352" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="Spotify player"></iframe>
    </div>

    <div class="song__actions">
        <form asp-action="Toggle" asp-controller="ListenLater" method="post">
            <input type="hidden" name="songId" value="@Model.Song.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="save @(Model.Saved ? "is-saved" : "")" aria-pressed="@(Model.Saved ? "true" : "false")"
                    title="@(Model.Saved ? "Remove this track from your queue" : "Save this track for later")">
                <partial name="_SaveIcon" model="Model.Saved" />
                <span>@(Model.Saved ? "Saved for later" : "Save for later")</span>
            </button>
        </form>

        @* Removing a favorite happens on the profile, where the four tiles are — here it's add-only. *@
        @if (Model.IsFavorite)
        {
            <span class="song__pinned">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z" />
                </svg>
                One of your favorites
            </span>
        }
        else if (Model.HasFavoriteSlot)
        {
            <form asp-action="AddFavorite" asp-controller="Profile" method="post">
                <input type="hidden" name="songId" value="@Model.Song.Id" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="save" title="Pin this track to your profile">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    </svg>
                    <span>Add to favorites</span>
                </button>
            </form>
        }
    </div>

    <div class="song__body">
        @if (reviewCount > 0)
        {
            <div class="rating-summary">
                <div class="score score--hero" title="Average rating @avgRating out of 10">
                    <span class="score__value">@avgRating</span><span class="score__scale">/10</span>
                </div>
                <div class="rating-summary__meta">
                    <span class="rating-summary__label">Average rating</span>
                    <span class="rating-summary__count">from @reviewCount @(reviewCount == 1 ? "review" : "reviews")</span>
                </div>
            </div>
        }

        @if (myReview != null)
        {
            <div class="your-review" id="yourReview">
                <div class="your-review__head">
                    <span class="your-review__label">Your review</span>
                    <div class="your-review__actions">
                        <button class="btn btn-ghost btn-sm" type="button" data-edit-review>Edit</button>
                        <form asp-action="Delete" asp-controller="Review" asp-route-reviewid="@myReview.ReviewId" method="post">
                            <button type="submit" class="btn btn-ghost-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
                <div class="your-review__body">
                    <div class="score score--chip" title="You rated this @myReview.Rating out of 10">
                        <span class="score__value">@myReview.Rating</span><span class="score__scale">/10</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(myReview.WrittenReview))
                    {
                        <p class="your-review__text">@myReview.WrittenReview</p>
                    }
                </div>
            </div>
        }

        <form class="composer" id="composer" asp-action="SubmitReview" asp-controller="Songs" asp-route-songId="@Model.Song.Id" method="post" hidden="@editing">
            <h2 class="composer__title">@(editing ? "Edit your review" : "Rate this track")</h2>
            <div class="rating-field">
                <div class="fader__head">
                    <label class="fader__label" id="ratingLabel">Your rating</label>
                    <output class="rating-readout" id="ratingValue" for="rating">Not rated</output>
                </div>
                <div class="meter js-rating-meter" role="slider" tabindex="0"
                     aria-labelledby="ratingLabel" aria-valuemin="1" aria-valuemax="10" aria-valuenow="0"
                     data-input="rating" data-output="ratingValue" data-submit="postReview"></div>
                <div class="fader__scale"><span>1 · skip it</span><span>on repeat · 10</span></div>
                <input type="hidden" name="rating" id="rating" value="@(myReview != null ? Math.Round(myReview.Rating).ToString("0") : "")" />
            </div>
            <textarea class="input" name="writtenReview" rows="3" placeholder="Share your thoughts on this track… (optional)">@(myReview?.WrittenReview)</textarea>
            <div class="composer__actions">
                @if (editing)
                {
                    <button class="btn btn-ghost" type="button" data-cancel-edit>Cancel</button>
                }
                <button class="btn btn-primary" id="postReview" type="submit" disabled="@(!editing)">@(editing ? "Update review" : "Post review")</button>
            </div>
        </form>

        <section class="song__reviews">
            <div class="reviews-head">
                <h2 class="section-title">Reviews</h2>
                @if (others.Count > 1)
                {
                    @* Sorts the reviews on this page; older pages keep their own order. *@
                    <div class="sort" data-sort-group role="group" aria-label="Sort reviews">
                        <button class="sort__btn active" type="button" data-sort="new" aria-pressed="true">Newest</button>
                        <button class="sort__btn" type="button" data-sort="high" aria-pressed="false">Highest</button>
                    </div>
                }
            </div>
            @if (others.Count > 0)
            {
                <div class="reviews" id="reviewList">
                    @foreach (Review review in others.Items)
                    {
                        <partial name="_ReviewPartial" model="@ReviewViewModel.For(review, Model.LikeStats)" />
                    }
                </div>
                <partial name="_Pager" model="@PagerViewModel.For(others)" />
            }
            else if (others.HasPrevious)
            {
                <div class="empty">Nothing further back than this.</div>
                <partial name="_Pager" model="@PagerViewModel.For(others)" />
            }
            else
            {
                <div class="empty">@(myReview != null ? "No other reviews yet." : "No reviews yet — be the first to rate this track.")</div>
            }
        </section>
    </div>
</div>
