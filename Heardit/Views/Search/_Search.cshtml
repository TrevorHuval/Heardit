@model SearchResultsViewModel
@using Heardit.Areas.Identity.Data;
@{
    ViewData["Title"] = "Search";
    var query = Context.Request.Query["SearchString"].ToString();
}

<div class="feed__head">
    <h1 class="feed__title">Search results</h1>
    @if (!string.IsNullOrWhiteSpace(query))
    {
        <p class="feed__sub">Showing listeners and tracks for &ldquo;@query&rdquo;.</p>
    }
</div>

@if (Model.Users.Count > 0)
{
    <section class="search__section">
        <h2 class="section-title">Listeners</h2>
        <div class="user-list">
            @foreach (HearditUser user in Model.Users)
            {
                <a class="user-row" asp-controller="Profile" asp-action="Index" asp-route-username="@user.UserName">
                    <partial name="_Avatar" model="@(new AvatarViewModel(user.UserName))" />
                    <span class="user-row__name">@user.UserName</span>
                    <svg class="user-row__chev" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </a>
            }
        </div>
    </section>
}

<section class="search__section">
    @if (Model.Users.Count > 0)
    {
        <h2 class="section-title">Tracks</h2>
    }

    @if (Model.SpotifyUnavailable)
    {
        <div class="empty">Couldn't reach Spotify to search for tracks. Try again in a minute.</div>
    }
    else if (Model.Tracks.Count > 0)
    {
        <div class="feed">
            @foreach (var item in Model.Tracks)
            {
                <partial name="_FeedCard" model="item" />
            }
        </div>
    }
    else
    {
        <div class="empty">No tracks matched your search. Try a different title or artist.</div>
    }
</section>
