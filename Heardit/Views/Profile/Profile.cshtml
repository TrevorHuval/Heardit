@model ProfileViewModel
@using Heardit.Areas.Identity.Data;
@{
    ViewData["Title"] = "Profile";
    var IsCurrentUser = Model.User.Id.Equals(User.GetLoggedInUserId<string>());
    var followsListRoute = new Dictionary<string, string>()
    {
        { "username", Model.User.UserName ?? string.Empty }
    };
}

<div class="profile">
    <header class="profile__banner">
        <partial name="_Avatar" model="@(new AvatarViewModel(Model.User.UserName, "xl"))" />
        <div class="profile__id">
            <p class="eyebrow">Listener</p>
            <h1 class="profile__name">@Model.User.UserName</h1>
        </div>
        <div class="profile__stats">
            <a class="stat" asp-action="Index" asp-controller="Follow" asp-all-route-data="followsListRoute" asp-route-tab="followers">
                <span class="stat__num tnum">@Model.FollowersCount</span>
                <span class="stat__label">Followers</span>
            </a>
            <a class="stat" asp-action="Index" asp-controller="Follow" asp-all-route-data="followsListRoute" asp-route-tab="following">
                <span class="stat__num tnum">@Model.FollowingCount</span>
                <span class="stat__label">Following</span>
            </a>
        </div>
        <div class="profile__action">
            @if (IsCurrentUser)
            {
                <a id="manage" class="btn btn-ghost" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Edit profile</a>
            }
            else
            {
                var followRoute = new Dictionary<string, string>() { { "userId", Model.User.Id } };
                if (Model.IsFollowing)
                {
                    <form asp-action="UnFollow" asp-controller="Profile" asp-all-route-data="followRoute" method="post">
                        <button type="submit" class="btn btn-ghost">Unfollow</button>
                    </form>
                }
                else
                {
                    <form asp-action="Follow" asp-controller="Profile" asp-all-route-data="followRoute" method="post">
                        <button type="submit" class="btn btn-primary">Follow</button>
                    </form>
                }
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.User.Bio) || IsCurrentUser)
    {
        <section class="profile__bio">
            @if (!string.IsNullOrWhiteSpace(Model.User.Bio))
            {
                <p class="profile__bio-text">@Model.User.Bio</p>
            }
            @if (IsCurrentUser)
            {
                @* A disclosure rather than a modal: no JS, and it stays shut until there's a reason. *@
                <details class="disclosure">
                    <summary class="disclosure__summary">@(string.IsNullOrWhiteSpace(Model.User.Bio) ? "Add a bio" : "Edit bio")</summary>
                    <form class="disclosure__body" asp-action="UpdateBio" asp-controller="Profile" method="post">
                        <textarea class="input" name="bio" rows="3" maxlength="@HearditUser.BioMaxLength"
                                  placeholder="What are you listening to these days?">@Model.User.Bio</textarea>
                        <div class="disclosure__actions">
                            <span class="muted">@HearditUser.BioMaxLength characters max.</span>
                            <button type="submit" class="btn btn-primary btn-sm">Save bio</button>
                        </div>
                    </form>
                </details>
            }
        </section>
    }

    @if (Model.Favorites.Count > 0 || IsCurrentUser)
    {
        <section class="profile__section">
            <h2 class="section-title">Favorites</h2>
            @if (Model.Favorites.Count > 0)
            {
                <div class="favorites">
                    @foreach (FavoriteTrack favorite in Model.Favorites)
                    {
                        <div class="favorite">
                            <a class="favorite__tile" asp-controller="Songs" asp-action="Index" asp-route-songId="@favorite.SongId"
                               title="@favorite.Song.Title by @favorite.Song.Artist">
                                @if (!string.IsNullOrWhiteSpace(favorite.Song.AlbumArt))
                                {
                                    <img class="favorite__art" src="@favorite.Song.AlbumArt" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="favorite__art favorite__art--blank" aria-hidden="true"></span>
                                }
                                <span class="favorite__meta">
                                    <span class="favorite__title">@favorite.Song.Title</span>
                                    <span class="favorite__artist">@favorite.Song.Artist</span>
                                </span>
                            </a>
                            @if (IsCurrentUser)
                            {
                                <form asp-action="RemoveFavorite" asp-controller="Profile" method="post">
                                    <input type="hidden" name="songId" value="@favorite.SongId" />
                                    <button type="submit" class="favorite__remove" aria-label="Remove @favorite.Song.Title from your favorites" title="Remove from favorites">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty">Pin up to @FavoriteTrack.MaxPerUser tracks here from any song page.</div>
            }
        </section>
    }

    <section class="profile__section">
        <h2 class="section-title">Reviews</h2>
        @if (Model.Reviews.Count > 0)
        {
            <div class="reviews">
                @foreach (Review review in Model.Reviews.Items)
                {
                    <partial name="_ReviewPartial" model="@ReviewViewModel.For(review, Model.LikeStats)" />
                }
            </div>
            <partial name="_Pager" model="@PagerViewModel.For(Model.Reviews)" />
        }
        else if (Model.Reviews.HasPrevious)
        {
            <div class="empty">Nothing further back than this.</div>
            <partial name="_Pager" model="@PagerViewModel.For(Model.Reviews)" />
        }
        else
        {
            <div class="empty">@(IsCurrentUser ? "You haven't posted any reviews yet." : "This listener hasn't posted any reviews yet.")</div>
        }
    </section>
</div>
